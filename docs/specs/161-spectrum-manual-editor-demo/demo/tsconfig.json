{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "typeRoots": ["../../../../frontend/node_modules/@types"],
    "baseUrl": ".", "paths": {
      "react": ["../../../../frontend/node_modules/@types/react"],
      "react/*": ["../../../../frontend/node_modules/@types/react/*"],
      "react-dom/*": ["../../../../frontend/node_modules/@types/react-dom/*"],
      "vitest": ["../../../../frontend/node_modules/vitest"]
    }
  },
  "include": ["src", "tests/*.test.ts"]
}
