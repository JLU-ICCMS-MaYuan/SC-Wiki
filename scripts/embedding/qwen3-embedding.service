[Unit]
Description=Qwen3-Embedding-4B local inference
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/qwen3-embedding/config.env
WorkingDirectory=%h/qwen3-embedding
ExecStart=%h/qwen3-embedding/.venv/bin/python %h/qwen3-embedding/source/serve.py
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
