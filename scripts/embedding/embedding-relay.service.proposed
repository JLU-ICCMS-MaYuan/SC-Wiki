# 待平台放行出站 SSH 且用户授权阿里云入口变更后启用。
[Unit]
Description=Private reverse tunnel for Qwen3 embedding
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -i %h/qwen3-embedding/relay_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=%h/qwen3-embedding/aliyun-known-hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 172.19.0.1:18080:127.0.0.1:8000 embedding-relay@47.111.123.225
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
