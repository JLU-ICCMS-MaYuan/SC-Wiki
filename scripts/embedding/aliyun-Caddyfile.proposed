# 初始完整配置模板；当前部署使用基础 Caddyfile 的可选持久片段导入。
{$SITE_DOMAIN} {
    encode zstd gzip
    @embedding path /embedding/v1/embeddings /embedding/v1/models
    handle @embedding {
        request_body {
            max_size 2MiB
        }
        uri strip_prefix /embedding
        reverse_proxy 172.19.0.1:18080 {
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
            }
        }
    }
    @embeddingOther path /embedding /embedding/*
    handle @embeddingOther {
        respond "Not found" 404
    }
    @api path /api/* /health
    handle @api {
        request_body {
            max_size 51MiB
        }
        reverse_proxy goserver:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
    handle {
        reverse_proxy frontend:80
    }
}

{$SITE_APEX} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}
