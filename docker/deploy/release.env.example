# 复制到服务器 /opt/scwiki/release.env；所有 digest 替换为实际验证结果。
DEPLOYMENT_ID=scwiki
SCWIKI_ROOT=/opt/scwiki
# 可选：仅改变本项目持久卷名称和宿主目录，不移动 Docker/containerd 引擎。
# SCWIKI_VOLUME_PREFIX=scwiki-home
# SCWIKI_VOLUME_ROOT=/home/mayuan/scwiki-containered
SOURCE_COMMIT=替换为40位Git提交
SITE_DOMAIN=www.sc-wiki.com
SITE_APEX=sc-wiki.com
FRONTEND_IMAGE=mayuanmark/scwiki-frontend@sha256:替换
GOSERVER_IMAGE=mayuanmark/scwiki-goserver@sha256:替换
PYTHON_IMAGE=mayuanmark/scwiki-python@sha256:替换
MYSQL_IMAGE=mysql@sha256:替换
REDIS_IMAGE=redis@sha256:替换
NEO4J_IMAGE=neo4j@sha256:替换
QDRANT_IMAGE=qdrant/qdrant@sha256:替换
GARAGE_IMAGE=dxflrs/garage@sha256:替换
GROBID_IMAGE=lfoppiano/grobid@sha256:替换
CADDY_IMAGE=caddy@sha256:替换
