# ====== SC-Wiki Docker 环境变量 ======
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ====== 数据库 ======
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=superconductor_dataset_v2
MYSQL_USER=scwiki
MYSQL_PASSWORD=change_me_mysql_password

# Go 连接字符串 (容器内服务名)
DATABASE_URL=mysql+pymysql://scwiki:${MYSQL_PASSWORD}@mysql:3306/superconductor_dataset_v2?charset=utf8mb4
# Python RAG 连接字符串
RAG_DATABASE_URL=mysql+asyncmy://scwiki:${MYSQL_PASSWORD}@mysql:3306/superconductor_dataset_v2?charset=utf8mb4

# ====== JWT ======
JWT_SECRET_KEY=change_me_long_random_string_here

# ====== AI API ======
# 通用 OpenAI 兼容配置优先；留空时回退到下方 DeepSeek 配置。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER_NAME=
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ====== Neo4j ======
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_password

# ====== 服务端口 ======
PORT=8080
PYTHON_BACKEND_URL=http://python:8000

# ====== 数据目录 ======
SC_WIKI_DATA_DIR=/data

# ====== 注册邮箱验证码（网易 163） ======
# SMTP_PASSWORD 填网易客户端授权码，不是邮箱登录密码；切勿提交真实值。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=sc_wiki@163.com
SMTP_PASSWORD=
SMTP_FROM=sc_wiki@163.com
SMTP_TLS_MODE=implicit
